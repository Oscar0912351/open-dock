{
  "name": "open-dock",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Lightweight, Windows-native liquid-glass desktop dock and D3D11 wallpaper engine.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Oscar0912351/open-dock.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "bindings": "cd src-tauri && cargo test export_bindings",
    "tauri": "tauri",
    "dev:tauri": "tauri dev",
    "tauri:dev": "tauri dev",
    "build:tauri": "node scripts/build-release.mjs",
    "tauri:build": "node scripts/build-release.mjs",
    "build:tauri:dir": "node scripts/kill-app.mjs && tauri build --debug --no-bundle",
    "publish": "node scripts/publish-release.mjs",
    "release": "npm run build:tauri && npm run publish"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "@tauri-apps/plugin-log": "^2.10.2",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
