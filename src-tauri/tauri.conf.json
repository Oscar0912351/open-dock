{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Dock",
  "version": "0.1.0",
  "identifier": "dev.opendock.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/plates/**", "$APPCACHE/art/**", "$APPCACHE/wallpapers/**", "$APPCACHE/discord-avatars/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "resources/cpu-sensor/*": "cpu-sensor/",
      "resources/cpu-sensor/licenses/*": "cpu-sensor/licenses/"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  }
}
